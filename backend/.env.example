# ===== ContractGuard 后端配置 =====
# 复制为 .env 后填写。默认 mock 模式不需要任何 Key，可直接跑通规则链路。

# 供应商/模型/路由在 data/llm_profiles.yaml 中配置；这里只放 Key 和默认路由。
# 默认路由：balanced / quality / deepseek-first / local（留空用 YAML 的 default_route）
LLM_ROUTE=
# 自定义 profiles 路径（可选，默认 data/llm_profiles.yaml）
# CONTRACTGUARD_LLM_PROFILES=

# 各 Provider Key（用哪个填哪个；本地 Ollama/vLLM 可不填）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
OLLAMA_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# mock: 不调用外部模型，仅规则引擎 + 模板修改建议
# live: 按 llm_profiles.yaml 的路由调用，失败自动回退
LLM_MODE=mock

# LLM_MODEL 仅用于 llm_profiles.yaml 缺失时的 legacy 单 profile；
# 实际聊天模型以 data/llm_profiles.yaml 为准。
LLM_MODEL=qwen-plus
LLM_TIMEOUT_S=90
LLM_DEADLINE_S=180

# Embedding 可单独指向其它 OpenAI 兼容服务；留空则复用 DASHSCOPE_*
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 可选 reranker（DashScope text-rerank）；默认关闭，失败自动回退 RRF
RERANK_ENABLED=0
RERANK_API_KEY=
# native = DashScope 原生 input/parameters；openai = qwen3-rerank 扁平接口
RERANK_API_STYLE=native
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=gte-rerank-v2
RERANK_INSTRUCT=
RERANK_TOP_N=20
RERANK_TIMEOUT_S=30

# 任务快照 SQLite（默认 data/jobs.sqlite3）与保留天数
# CONTRACTGUARD_DB_PATH=
# 上传临时目录（默认 data/uploads；Docker 部署建议放到持久化卷内）
# CONTRACTGUARD_UPLOAD_DIR=
JOB_RETENTION_DAYS=7

# 图内 HITL：存在已核实高风险时暂停，等待人工复核
HITL_ENABLED=1
HITL_RESUME_ON_STARTUP=1
# Checkpoint SQLite（默认 data/checkpoints.sqlite3）；与 jobs 分开
# CONTRACTGUARD_CHECKPOINT_DB_PATH=

# SQLite lease worker（多进程/多 worker 用 DB 租约协调；SYNC_JOBS=1 时禁用）
WORKER_ENABLED=1
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_S=1.0
LEASE_SECONDS=60
HEARTBEAT_SECONDS=15

# At-rest 加密（可选）：checkpoint + jobs.state_json 使用 AES-GCM。
# 主密钥至少 16 字符；生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 注意：密钥丢失后旧数据无法解密，不支持在线轮换；关闭加密不会解密旧数据。
ENCRYPTION_ENABLED=0
CONTRACTGUARD_MASTER_KEY=

# 可选单租户 API Token；设置后 /api/* 需要 Authorization: Bearer <token>
# 前端会显示 Token 登录页；/api/health 保持公开供健康检查。
# CONTRACTGUARD_API_TOKEN=

# 活跃任务/上传防护与可选进程内限流（0 表示关闭限流）
MAX_ACTIVE_JOBS=20
RATE_LIMIT_PER_MINUTE=0
PDF_MAX_PAGES=200
DOCX_MAX_UNCOMPRESSED_MB=200

# 前端开发服务器地址（CORS）
CORS_ORIGIN=http://localhost:5173

# 上传限制（MB）
MAX_UPLOAD_MB=50

# 扫描件 OCR（本地离线，模型随依赖安装）
OCR_MAX_PAGES=50
OCR_RENDER_SCALE=2.0
OCR_MIN_SCORE=0.5
OCR_MIN_PAGE_CHARS=20
OCR_MAX_RENDER_SIDE=3000

# 测试时可设为 1：POST 内联执行完整审查再返回
SYNC_JOBS=0

# 可选：保存每次任务的 trace 到 data/runs（默认关闭）
SAVE_TRACES=0
